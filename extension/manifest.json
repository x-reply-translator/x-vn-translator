{
  "manifest_version": 3,
  "name": "X 베트남어 번역기",
  "version": "1.0.0",
  "description": "X 댓글창의 베트남어를 한국어·영어·중국어로 바꾸고, 베트남어 글은 세 언어 중 골라 해석. 내 API 키로 동작.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://api.anthropic.com/*", "https://api.openai.com/*"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_title": "X 베트남어 번역기 설정", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}},
  "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"},
  "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
